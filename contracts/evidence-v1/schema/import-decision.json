{
  "$defs": {
    "Envelope": {
      "additionalProperties": false,
      "properties": {
        "contract_version": {
          "const": "1.0",
          "title": "Contract Version",
          "type": "string"
        },
        "producer": {
          "const": "minivision-reconstruct",
          "title": "Producer",
          "type": "string"
        },
        "producer_revision": {
          "pattern": "^[a-f0-9]{40}$",
          "title": "Producer Revision",
          "type": "string"
        },
        "case_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Case Id",
          "type": "string"
        },
        "created_at": {
          "title": "Created At",
          "type": "string"
        },
        "processing_policy": {
          "const": "local_only",
          "title": "Processing Policy",
          "type": "string"
        },
        "config_identifiers": {
          "items": {
            "type": "string"
          },
          "title": "Config Identifiers",
          "type": "array"
        },
        "model_identifiers": {
          "items": {
            "type": "string"
          },
          "title": "Model Identifiers",
          "type": "array"
        },
        "artifacts": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Artifacts",
          "type": "object"
        },
        "sources": {
          "items": {
            "$ref": "#/$defs/SourceBinding"
          },
          "title": "Sources",
          "type": "array"
        }
      },
      "required": [
        "contract_version",
        "producer",
        "producer_revision",
        "case_id",
        "created_at",
        "processing_policy",
        "config_identifiers",
        "model_identifiers",
        "artifacts",
        "sources"
      ],
      "title": "Envelope",
      "type": "object"
    },
    "NormalizedRecord": {
      "additionalProperties": false,
      "properties": {
        "record_id": {
          "title": "Record Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "source_binding",
            "track_reference",
            "event_proposal",
            "geometry",
            "review_overlay",
            "assessment",
            "sequence"
          ],
          "title": "Kind",
          "type": "string"
        },
        "view_id": {
          "title": "View Id",
          "type": "string"
        },
        "artifact_path": {
          "title": "Artifact Path",
          "type": "string"
        },
        "original": {
          "additionalProperties": true,
          "title": "Original",
          "type": "object"
        },
        "effective": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Effective"
        },
        "source_frame": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Frame"
        },
        "source_time": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Time"
        },
        "timestamp_provenance": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Timestamp Provenance"
        },
        "track_refs": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Track Refs",
          "type": "array"
        },
        "producer_status": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Producer Status"
        },
        "parent_status": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parent Status"
        },
        "needs_review": {
          "default": false,
          "title": "Needs Review",
          "type": "boolean"
        },
        "affirmative": {
          "const": false,
          "default": false,
          "title": "Affirmative",
          "type": "boolean"
        },
        "officer_approved": {
          "const": false,
          "default": false,
          "title": "Officer Approved",
          "type": "boolean"
        },
        "rule_source": {
          "default": null,
          "title": "Rule Source",
          "type": "null"
        }
      },
      "required": [
        "record_id",
        "kind",
        "view_id",
        "artifact_path",
        "original"
      ],
      "title": "NormalizedRecord",
      "type": "object"
    },
    "SourceBinding": {
      "additionalProperties": false,
      "properties": {
        "view_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "View Id",
          "type": "string"
        },
        "original_video_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Original Video Sha256",
          "type": "string"
        },
        "reconstruction_manifest": {
          "title": "Reconstruction Manifest",
          "type": "string"
        },
        "movement_manifest": {
          "title": "Movement Manifest",
          "type": "string"
        },
        "incident_manifest": {
          "title": "Incident Manifest",
          "type": "string"
        },
        "reviewed_manifest": {
          "title": "Reviewed Manifest",
          "type": "string"
        },
        "tracking_run": {
          "title": "Tracking Run",
          "type": "string"
        },
        "track_revision": {
          "title": "Track Revision",
          "type": "string"
        },
        "calibration_revision": {
          "title": "Calibration Revision",
          "type": "string"
        },
        "reconstruction_run": {
          "title": "Reconstruction Run",
          "type": "string"
        },
        "movement_run": {
          "title": "Movement Run",
          "type": "string"
        },
        "incident_run": {
          "title": "Incident Run",
          "type": "string"
        },
        "review_revision": {
          "title": "Review Revision",
          "type": "string"
        },
        "video_metadata": {
          "additionalProperties": true,
          "title": "Video Metadata",
          "type": "object"
        },
        "transformations": {
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "title": "Transformations",
          "type": "array"
        },
        "frame_origin": {
          "const": 0,
          "title": "Frame Origin",
          "type": "integer"
        }
      },
      "required": [
        "view_id",
        "original_video_sha256",
        "reconstruction_manifest",
        "movement_manifest",
        "incident_manifest",
        "reviewed_manifest",
        "tracking_run",
        "track_revision",
        "calibration_revision",
        "reconstruction_run",
        "movement_run",
        "incident_run",
        "review_revision",
        "video_metadata",
        "transformations",
        "frame_origin"
      ],
      "title": "SourceBinding",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "import_id": {
      "title": "Import Id",
      "type": "string"
    },
    "importer_version": {
      "default": "1.0.0",
      "title": "Importer Version",
      "type": "string"
    },
    "provenance_state": {
      "enum": [
        "verified",
        "incomplete_provenance",
        "rejected"
      ],
      "title": "Provenance State",
      "type": "string"
    },
    "issues": {
      "items": {
        "type": "string"
      },
      "title": "Issues",
      "type": "array"
    },
    "records": {
      "default": [],
      "items": {
        "$ref": "#/$defs/NormalizedRecord"
      },
      "title": "Records",
      "type": "array"
    },
    "accepted_records": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Accepted Records",
      "type": "array"
    },
    "quarantined_records": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Quarantined Records",
      "type": "array"
    },
    "source_hashes": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Source Hashes",
      "type": "object"
    },
    "envelope": {
      "anyOf": [
        {
          "$ref": "#/$defs/Envelope"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "import_id",
    "provenance_state",
    "issues"
  ],
  "title": "ImportDecision",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
