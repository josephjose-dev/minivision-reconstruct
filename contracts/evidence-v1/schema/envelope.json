          "type": "string"
        },
        "original_video_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Original Video Sha256",
          "type": "string"
        },
        "reconstruction_manifest": {
          "title": "Reconstruction Manifest",
          "type": "string"
        },
        "movement_manifest": {
          "title": "Movement Manifest",
          "type": "string"
        },
        "incident_manifest": {
          "title": "Incident Manifest",
          "type": "string"
        },
        "reviewed_manifest": {
          "title": "Reviewed Manifest",
          "type": "string"
        },
        "tracking_run": {
          "title": "Tracking Run",
          "type": "string"
        },
        "track_revision": {
          "title": "Track Revision",
          "type": "string"
        },
        "calibration_revision": {
          "title": "Calibration Revision",
          "type": "string"
        },
        "reconstruction_run": {
          "title": "Reconstruction Run",
          "type": "string"
        },
        "movement_run": {
          "title": "Movement Run",
          "type": "string"
        },
        "incident_run": {
          "title": "Incident Run",
          "type": "string"
        },
        "review_revision": {
          "title": "Review Revision",
          "type": "string"
        },
        "video_metadata": {
          "additionalProperties": true,
          "title": "Video Metadata",
          "type": "object"
        },
        "transformations": {
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "title": "Transformations",
          "type": "array"
        },
        "frame_origin": {
          "const": 0,
          "title": "Frame Origin",
          "type": "integer"
        }
      },
      "required": [
        "view_id",
        "original_video_sha256",
        "reconstruction_manifest",
        "movement_manifest",
        "incident_manifest",
        "reviewed_manifest",
        "tracking_run",
        "track_revision",
        "calibration_revision",
        "reconstruction_run",
        "movement_run",
        "incident_run",
        "review_revision",
        "video_metadata",
        "transformations",
        "frame_origin"
      ],
      "title": "SourceBinding",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "contract_version": {
      "const": "1.0",
      "title": "Contract Version",
      "type": "string"
    },
    "producer": {
      "const": "minivision-reconstruct",
      "title": "Producer",
      "type": "string"
    },
    "producer_revision": {
      "pattern": "^[a-f0-9]{40}$",
      "title": "Producer Revision",
      "type": "string"
    },
    "case_id": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Case Id",
      "type": "string"
    },
    "created_at": {
      "title": "Created At",
      "type": "string"
    },
    "processing_policy": {
      "const": "local_only",
      "title": "Processing Policy",
      "type": "string"
    },
    "config_identifiers": {
      "items": {
        "type": "string"
      },
      "title": "Config Identifiers",
      "type": "array"
    },
    "model_identifiers": {
      "items": {
        "type": "string"
      },
      "title": "Model Identifiers",
      "type": "array"
    },
    "artifacts": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Artifacts",
      "type": "object"
    },
    "sources": {
      "items": {
        "$ref": "#/$defs/SourceBinding"
      },
      "title": "Sources",
      "type": "array"
    }
  },
  "required": [
    "contract_version",
    "producer",
    "producer_revision",
    "case_id",
    "created_at",
    "processing_policy",
    "config_identifiers",
    "model_identifiers",
    "artifacts",
    "sources"
  ],
  "title": "Envelope",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
