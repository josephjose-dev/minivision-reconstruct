    },
    "track_refs": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Track Refs",
      "type": "array"
    },
    "producer_status": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
