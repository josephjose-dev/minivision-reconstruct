# Copy to .env.test (gitignored); worktrees fall back to the main checkout's file.
# Docker container incident-pg. Never put a password inside a URL: libpq reads PGPASSWORD.
PGPASSWORD=postgres
TEST_DATABASE_URL=postgresql://postgres@localhost:5433/postgres
# Folder holding pg_dump 16 or newer, if it is not on PATH.
INCIDENT_PG_BIN_DIR=C:/Users/HP/tools/pgsql16/pgsql/bin

# IncidentDesk uses DATABASE_URL=postgresql://postgres@127.0.0.1:5433/incidentdesk_dev
# Tests must use TEST_DATABASE_URL=postgresql://postgres@127.0.0.1:5433/incidentdesk_test_admin
# Create both on a dedicated local cluster; never use the donor database.
# Export the test URL in your shell to override the legacy example value above.
